ICERDE_API_ADDR=127.0.0.1:43148
ICERDE_WEB_ORIGIN=http://127.0.0.1:43147
ICERDE_WEB_URL=http://127.0.0.1:43147
ICERDE_CODE_PEPPER=
ICERDE_PROJECTS_ROOT=

# Real outbound mail: set SMTP *or* Resend. If both are set, Resend wins.
# Without either, codes stay in the in-app mailbox (dev sink). Login UI will say so.
# ICERDE_MAIL_REQUIRE=1  # fail closed if neither transport is configured

# Gmail: Google Account → Security → App passwords (2FA required). Not your login password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=İçerde <icerde@localhost>

# Resend HTTP API from our Go process (not an inbox SaaS MCP).
RESEND_API_KEY=
RESEND_FROM=İçerde <icerde@localhost>

# LLM A (optional). Empty = mock completer still wrapped by GDPR.
ICERDE_LLM_API_KEY=
ICERDE_LLM_BASE_URL=
ICERDE_LLM_MODEL=

# OpenCode CLI (writer). Empty PATH lookup. Missing CLI keeps the scaffold — no fake write.
# ICERDE_OPENCODE_BIN=
# ICERDE_OPENCODE_TIMEOUT_SEC=480
# ICERDE_OPENCODE_REQUIRE=1
# ICERDE_OPENCODE_MODEL=
