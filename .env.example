CHERRY_API_ADDR=127.0.0.1:43148
CHERRY_WEB_ORIGIN=http://127.0.0.1:43147
CHERRY_WEB_URL=http://127.0.0.1:43147
CHERRY_CODE_PEPPER=
CHERRY_PROJECTS_ROOT=

# Platform MongoDB (auth, sessions, projects metadata, LLM state, audit).
# Empty = in-memory store (lost on restart).
# Prefer: npm run dev:api runs scripts/ensure-mongo.sh (native mongod) when installed.
# Or: docker compose up -d mongo
MONGO_URI=mongodb://127.0.0.1:27017/cherry

# Real outbound mail: set SMTP *or* Resend. If both are set, Resend wins.
# Without either, codes stay in the in-app mailbox (dev sink). Login UI will say so.
# CHERRY_MAIL_REQUIRE=1  # fail closed if neither transport is configured

# Gmail: Google Account → Security → App passwords (2FA required). Not your login password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM='Cherry <cherry@localhost>'

# Resend HTTP API from our Go process (not an inbox SaaS MCP).
RESEND_API_KEY=
RESEND_FROM='Cherry <cherry@localhost>'

# LLM A (optional). Empty = mock completer still wrapped by GDPR.
CHERRY_LLM_API_KEY=
CHERRY_LLM_BASE_URL=
CHERRY_LLM_MODEL=

# OpenCode CLI (writer). Empty = sidecar lookup then PATH. Missing CLI keeps the scaffold — no fake write.
# CHERRY_OPENCODE_BIN=
# CHERRY_OPENCODE_TIMEOUT_SEC=480
# CHERRY_OPENCODE_REQUIRE=1
# CHERRY_OPENCODE_MODEL=

# OAuth 2.0 (optional). Empty = local consent screen. Set these to redirect to the real provider.
# GitHub OAuth App callback: http://127.0.0.1:43148/oauth/provider/callback
# CHERRY_GITHUB_CLIENT_ID=
# CHERRY_GITHUB_CLIENT_SECRET=
# CHERRY_VERCEL_CLIENT_ID=
# CHERRY_VERCEL_CLIENT_SECRET=
# CHERRY_SUPABASE_CLIENT_ID=
# CHERRY_SUPABASE_CLIENT_SECRET=
# Cloudflare needs CLIENT_ID + AUTH_URL + TOKEN_URL (no fixed public authorize URL).
# CHERRY_CLOUDFLARE_CLIENT_ID=
# CHERRY_CLOUDFLARE_CLIENT_SECRET=
# CHERRY_CLOUDFLARE_AUTH_URL=
# CHERRY_CLOUDFLARE_TOKEN_URL=
# CHERRY_CLOUDFLARE_USER_URL=
# CHERRY_RENDER_CLIENT_ID=
# CHERRY_RENDER_CLIENT_SECRET=
# CHERRY_RENDER_AUTH_URL=
# CHERRY_RENDER_TOKEN_URL=

# Sidecars bundled by the Cherry installer (customer does not install these).
# CHERRY_SIDECAR_DIR=
# CHERRY_MAESTRO_BIN=
# CHERRY_MAESTRO_DEVICE=          # adb serial or iOS UDID
# CHERRY_MAESTRO_START_DEVICE=1   # optional: maestro start-device when none online
# CHERRY_MAESTRO_PLATFORM=android # used with START_DEVICE (ios on Mac)
# CHERRY_CLOUDFLARED_BIN=
# Colab bridge (loopback only). cloudflared publishes this — not GraphQL :43148.
# CHERRY_COLAB_BRIDGE_ADDR=127.0.0.1:43149

# Colab temporary inference (named Cloudflare tunnel). Token runs IN COLAB only —
# never put a real token in this file, git, or the Go API process. Rotate if leaked.
# CHERRY_COLAB_PUBLIC_URL=https://colab.yourdomain.com
# CLOUDFLARE_TUNNEL_TOKEN=   # never commit real token; Colab secret / local only
