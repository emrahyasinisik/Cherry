{
  "name": "cherry",
  "private": true,
  "description": "Cherry desktop studio \u2014 scaffold",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "echo 'Run dev:api and dev:web in two terminals (see README).'",
    "dev:api": "bash -lc 'unset npm_config_prefix; bash scripts/dev-bootstrap.sh; go -C services/api run ./cmd/api'",
    "dev:web": "npm run dev --workspace cherry-web",
    "dev:desktop": "npm run start --workspace cherry-desktop",
    "build:web": "npm run build --workspace cherry-web",
    "start:web": "npm run start --workspace cherry-web",
    "dist:desktop": "bash scripts/package-desktop.sh",
    "lint": "npm run lint --workspaces --if-present"
  }
}
