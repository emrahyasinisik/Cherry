"""Icerde platform GraphQL — not the generated customer app API."""
type Query {
  health: Health!
  me: User
  projects: [Project!]!
  project(id: ID!): Project
  maestroStudio(projectId: ID!): MaestroStudio!
  devices: [Device!]!
  sessions: [Session!]!
  mailbox: [MailMessage!]!
  challengeMailbox(challengeId: ID!): MailMessage
  llmAdmin: LlmAdmin!
  llmStatus: LlmStatus!
  mcpReadFile(relativePath: String!): String!
  exportMe: ExportBundle!
  trainingPack: TrainingPack!
  connections: [Connection!]!
}

type Mutation {
  register(
    email: String!
    password: String!
    deviceFingerprint: String!
    deviceLabel: String!
  ): LoginResult!
  login(
    email: String!
    password: String!
    deviceFingerprint: String!
    deviceLabel: String!
  ): LoginResult!
  verifyCode(challengeId: ID!, code: String!, trustDevice: Boolean!): LoginResult!
  verifyLink(token: String!, deviceFingerprint: String!, deviceLabel: String!): LoginResult!
  verifyTotp(challengeId: ID!, code: String!): LoginResult!
  enableTotp: TotpSetup!
  confirmTotp(code: String!): Boolean!
  disableTotp(code: String!): Boolean!
  revokeSession(id: ID!): Boolean!
  revokeDevice(id: ID!): Boolean!
  logout: Boolean!
  createProject(name: String!, brief: String!, stack: ProjectStack!, backendTarget: BackendTarget = LOCAL): Project!
  sendProjectMessage(projectId: ID!, body: String!): Project!
  activateProject(id: ID!): Project!
  deactivateProject(id: ID!): Project!
  runMaestro(projectId: ID!): Project!
  connectProvider(kind: ConnectionKind!, account: String!, token: String!): Connection!
  startConnectionOAuth(kind: ConnectionKind!): OAuthStart!
  completeConnectionOAuth(code: String!, state: String!): Connection!
  disconnectProvider(kind: ConnectionKind!): Connection!
  pushProjectGithub(projectId: ID!, repo: String!): GitPushResult!
  setActiveVersion(id: ID!): LlmAdmin!
  setMcpRoot(path: String!): LlmAdmin!
  registerLlmVersion(slot: String!, name: String!, note: String!, checkpointRef: String!): LlmAdmin!
  deleteMe(wipeProjects: Boolean!): Boolean!
}

enum LoginNext {
  SESSION
  DEVICE_CODE
  TOTP
}

enum VerifyPurpose {
  NEW_DEVICE
  LOGIN_CHALLENGE
  EMAIL_VERIFY
  SUSPICIOUS_LOGIN
}

type LoginResult {
  next: LoginNext!
  token: String
  challengeId: ID
  user: User
  emailSent: Boolean!
  emailChannel: String!
}

type Health {
  ok: Boolean!
  store: String!
  version: String!
  mail: String!
  gdpr: Boolean!
  llm: String!
}

type User {
  id: ID!
  email: String!
  workspaceKind: WorkspaceKind!
  totpEnabled: Boolean!
}

enum WorkspaceKind {
  PERSONAL
  ORGANIZATION
}

type Project {
  id: ID!
  name: String!
  brief: String!
  stack: ProjectStack!
  status: ProjectStatus!
  rootPath: String!
  backendTarget: BackendTarget!
  createdAt: String!
  logs: [JobLog!]!
  files: [ProjectFile!]!
  maestro: MaestroStudio!
  activate: LocalActivate!
}

enum ProjectStack {
  EXPO
  FLUTTER
  NATIVE
}

enum BackendTarget {
  LOCAL
  SUPABASE
  CLOUDFLARE
  RENDER
}

enum ConnectionKind {
  SUPABASE
  CLOUDFLARE
  GITHUB
  VERCEL
  RENDER
}

enum ConnectionStatus {
  DISCONNECTED
  CONNECTED
  FAILED
}

enum ConnectionAuth {
  NONE
  OAUTH
  TOKEN
}

enum OAuthMode {
  CONSENT
  PROVIDER
}

type OAuthStart {
  authorizeUrl: String!
  state: String!
  mode: OAuthMode!
}

type Connection {
  kind: ConnectionKind!
  status: ConnectionStatus!
  account: String!
  tokenHint: String!
  note: String!
  authMethod: ConnectionAuth!
  scopes: [String!]!
}

type GitPushResult {
  ok: Boolean!
  note: String!
}

enum ProjectStatus {
  QUEUED
  WRITING
  TESTING
  READY
  FAILED
}

enum MaestroResult {
  SKIPPED
  PASSED
  FAILED
}

enum ChatRole {
  USER
  AGENT
  SYSTEM
}

type JobLog {
  at: String!
  message: String!
  role: ChatRole!
}

type ProjectFile {
  path: String!
  kind: String!
}

enum ActivateStatus {
  IDLE
  STARTING
  RUNNING
  STOPPING
  FAILED
}

type LocalActivate {
  status: ActivateStatus!
  url: String
  port: Int
  pid: Int
  note: String!
}

type MaestroStudio {
  ready: Boolean!
  deviceStatus: String!
  screens: [DesignScreen!]!
  flows: [MaestroFlow!]!
}

type DesignScreen {
  id: ID!
  name: String!
  html: String!
}

type MaestroFlow {
  id: ID!
  name: String!
  yaml: String!
  result: MaestroResult!
  note: String!
}

type Device {
  id: ID!
  label: String!
  trusted: Boolean!
  current: Boolean!
  lastSeenAt: String!
}

type Session {
  id: ID!
  current: Boolean!
  createdAt: String!
  deviceLabel: String!
}

type MailMessage {
  id: ID!
  subject: String!
  body: String!
  purpose: VerifyPurpose!
  createdAt: String!
}

type TotpSetup {
  secret: String!
  otpauthUrl: String!
}

type LlmStatus {
  slot: String!
  versionName: String!
  channel: String!
  gdpr: Boolean!
  queued: Int!
  occupancyA: LlmOccupancy!
  occupancyB: LlmOccupancy!
  versionA: String!
  versionB: String!
}

type LlmAdmin {
  gdpr: Boolean!
  activeSlot: String!
  mcpRoot: String!
  queued: Int!
  slotA: LlmSlotCard!
  slotB: LlmSlotCard!
  completions: [LlmCompletion!]!
}

enum LlmOccupancy {
  IDLE
  BUSY
}

type LlmSlotCard {
  slot: String!
  wired: Boolean!
  role: String!
  occupancy: LlmOccupancy!
  activeVersionId: ID
  versions: [LlmVersion!]!
}

type LlmVersion {
  id: ID!
  name: String!
  note: String!
  checkpointRef: String!
}

type TrainingPack {
  schema: String!
  filename: String!
  json: String!
  jsonl: String!
  liveExamples: Int!
  seedExamples: Int!
  note: String!
}

type LlmCompletion {
  at: String!
  purpose: String!
  slot: String!
  versionName: String!
  channel: String!
  inputRedactions: Int!
  outputRedactions: Int!
  promptPreview: String!
  outputPreview: String!
}

type ExportBundle {
  json: String!
}
