"""Icerde platform GraphQL — not the generated customer app API."""
type Query {
  health: Health!
  me: User
  projects: [Project!]!
  devices: [Device!]!
  sessions: [Session!]!
  mailbox: [MailMessage!]!
  challengeMailbox(challengeId: ID!): MailMessage
}

type Mutation {
  register(
    email: String!
    password: String!
    deviceFingerprint: String!
    deviceLabel: String!
  ): LoginResult!
  login(
    email: String!
    password: String!
    deviceFingerprint: String!
    deviceLabel: String!
  ): LoginResult!
  verifyCode(challengeId: ID!, code: String!, trustDevice: Boolean!): LoginResult!
  verifyLink(token: String!, deviceFingerprint: String!, deviceLabel: String!): LoginResult!
  verifyTotp(challengeId: ID!, code: String!): LoginResult!
  enableTotp: TotpSetup!
  confirmTotp(code: String!): Boolean!
  disableTotp(code: String!): Boolean!
  revokeSession(id: ID!): Boolean!
  revokeDevice(id: ID!): Boolean!
  logout: Boolean!
}

enum LoginNext {
  SESSION
  DEVICE_CODE
  TOTP
}

enum VerifyPurpose {
  NEW_DEVICE
  LOGIN_CHALLENGE
  EMAIL_VERIFY
  SUSPICIOUS_LOGIN
}

type LoginResult {
  next: LoginNext!
  token: String
  challengeId: ID
  user: User
}

type Health {
  ok: Boolean!
  store: String!
  version: String!
}

type User {
  id: ID!
  email: String!
  workspaceKind: WorkspaceKind!
  totpEnabled: Boolean!
}

enum WorkspaceKind {
  PERSONAL
  ORGANIZATION
}

type Project {
  id: ID!
  name: String!
  stack: String!
  status: String!
}

type Device {
  id: ID!
  label: String!
  trusted: Boolean!
  current: Boolean!
  lastSeenAt: String!
}

type Session {
  id: ID!
  current: Boolean!
  createdAt: String!
  deviceLabel: String!
}

type MailMessage {
  id: ID!
  subject: String!
  body: String!
  purpose: VerifyPurpose!
  createdAt: String!
}

type TotpSetup {
  secret: String!
  otpauthUrl: String!
}
